    <Compile Include="Benchmark.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MeshOptPort\MeshOptPort.fsproj" />
  </ItemGroup>

</Project>
